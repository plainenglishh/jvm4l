local fs = require("@std/fs")
local process = require("@std/process")

local EXCEPTIONS: { [string]: string } = {
    Exception = "Throwable",
    RuntimeException = "Exception",
    Error = "Throwable",
    VirtualMachineError = "Error",

    NullPointerException = "RuntimeException",
    ClassCastException = "RuntimeException",
    ArithmeticException = "RuntimeException",
    IllegalArgumentException = "RuntimeException",
    IndexOutOfBoundsException = "RuntimeException",
    ArrayIndexOutOfBoundsException = "IndexOutOfBoundsException",
    IllegalStateException = "RuntimeException",
    UnsupportedOperationException = "RuntimeException",

    StackOverflowError = "VirtualMachineError",
    OutOfMemoryError = "VirtualMachineError",
    InternalError = "VirtualMachineError",

    LinkageError = "Error",
    UnsatisfiedLinkError = "LinkageError",
    NoClassDefFoundError = "LinkageError",
}

local TEMPLATE = [[package java.lang;

// generated by: scripts/buildjcl.luau
public class $name extends $parent {
    public $name() { super(); }
    public $name(String message) { super(message); }
    public $name(String message, Throwable cause) { super(message, cause); }
}
]]

print("--- generating exceptions")
for name, parent in EXCEPTIONS do
    local src = TEMPLATE:gsub("%$name", name):gsub("%$parent", parent)
    fs.writeStringToFile(`jcl/src/java/lang/exceptions/{name}.java`, src)
end

if fs.exists("jcl/bin") then
    fs.removeDirectory("jcl/bin", { recursive = true })
end

fs.createDirectory("jcl/bin")

local function find_files(path: string, ext: string)
    local files = {}

    local function find_files_recursive(dir: string)
        for _, entry in fs.listDirectory(dir) do
            local path = dir .. "/" .. entry.name

            if entry.type == "dir" then
                find_files_recursive(path)
            elseif entry.type == "file" and string.match(entry.name, `%.{ext}$`) then
                table.insert(files, path)
            end
        end
    end

    find_files_recursive(path)

    return files
end

local sources: { string } = find_files("jcl/src", "java")

print("--- building jcl")
local r = process.run({
    "javac",
    "-source",
    "1.8",
    "-target",
    "1.8",
    "-g:none",
    "-bootclasspath",
    "",
    "-sourcepath",
    "jcl/src",
    "-d",
    "jcl/bin",
    unpack(sources),
}, { stdio = "inherit" })

if not r.ok then
    error("failed to build!")
end

print("--- generating jcl_classfiles.luau")

local artifacts = find_files("jcl/bin", "class")

local out = {}

table.insert(out, "--- @generated\nlocal jcl: { [string]: buffer } = {}\n\n")

for _, artifact_path in artifacts do
    local artifact = fs.readFileToString(artifact_path):gsub(".", function(char: string)
        return string.format("\\x%02X", string.byte(char) or error(""))
    end)
    table.insert(
        out,
        string.format(
            'jcl[%q] = buffer.fromstring("%s")\n',
            artifact_path:match("^jcl/bin/(.+)%.class") or error(""),
            artifact
        )
    )
end

table.insert(out, "\nreturn jcl")

fs.writeStringToFile("src/lib/jcl_classfiles.luau", table.concat(out))

print("--- building docs")
local docs_r = process.system(
    'javadoc -source 1.8 -bootclasspath "" -sourcepath jcl/src -d jcl/docs -quiet -notimestamp -subpackages java:jvm4l',
    { stdio = "inherit" }
)

if not docs_r.ok then
    error("")
end
